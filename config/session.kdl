// Literal argv vectors for session action nodes. An empty argv disables an action.
// Nodes may override argv in Parameters. No shell is involved.
action "power_off" "systemctl" "poweroff"
action "reboot" "systemctl" "reboot"
action "suspend" "systemctl" "suspend"
action "hibernate" "systemctl" "hibernate"
action "log_out" "niri" "msg" "action" "quit" "--skip-confirmation"
action "lock_session" "loginctl" "lock-session"
