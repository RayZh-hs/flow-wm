// Minimal manual integration. Installed FlowWM generates these from keybindings.json.
binds {
    Mod+Tab repeat=false allow-inhibiting=false hotkey-overlay-title="FlowWM: Nodes / Windows" { spawn "flowwm" "toggle"; }
    Mod+Shift+Tab repeat=false allow-inhibiting=false hotkey-overlay-title="FlowWM: Return to windows" { spawn "flowwm" "windows"; }
    Mod+Space repeat=false allow-inhibiting=false hotkey-overlay-title="FlowWM: Dux search / create a node" { spawn "flowwm" "new"; }
    Mod+Shift+Space repeat=false allow-inhibiting=false hotkey-overlay-title="FlowWM: Find a node" { spawn "flowwm" "search"; }
    Mod+Shift+slash repeat=false allow-inhibiting=false hotkey-overlay-title="FlowWM: Shortcuts" { spawn "flowwm" "send" "{\"op\":\"ui\",\"command\":{\"action\":\"help\"}}"; }
}
