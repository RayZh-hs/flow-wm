// Isolated by scripts/dev.py; this never imports environment into the live session.
workspace "FlowWM test 1"
workspace "FlowWM test 2"

input { mod-key-nested "Super"; }

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Tab repeat=false allow-inhibiting=false { spawn "flowwm" "toggle"; }
    Mod+Q repeat=false allow-inhibiting=false { spawn "flowwm" "send" r#"{"action":"ui","command":{"action":"stop_selected"}}"#; }
    Mod+Space repeat=false { spawn "flowwm" "new"; }
    Mod+Minus { spawn "flowwm" "send" r#"{"action":"ui","command":{"action":"zoom_out"}}"#; }
    Mod+Equal { spawn "flowwm" "send" r#"{"action":"ui","command":{"action":"zoom_in"}}"#; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+E { quit skip-confirmation=true; }
}

// Extension interfaces open at their preferred size; ordinary nodes have no window.
window-rule {
    match app-id="^dev\\.flowwm\\.interface\\.v1\\."
    open-floating true
}
