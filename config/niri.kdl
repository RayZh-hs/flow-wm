// Merge into your Niri config. Replace existing bindings for these keys.
// Ensure `flowwm` is on the environment PATH used by Niri, or use its absolute path.
binds {
    Mod+Tab repeat=false allow-inhibiting=false { spawn "flowwm" "toggle"; }
    Mod+Space repeat=false { spawn "flowwm" "new"; }
    Mod+Up { spawn "flowwm" "navigate" "up"; }
    Mod+Down { spawn "flowwm" "navigate" "down"; }
    Mod+Left { spawn "flowwm" "navigate" "left"; }
    Mod+Right { spawn "flowwm" "navigate" "right"; }
}

// Optional, after installing FlowWM:
// spawn-at-startup "flowwm" "start"
